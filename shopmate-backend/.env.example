# ==========================================
# ShopMate Backend Environment Variables
# ==========================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopmate_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Alternatively set full JDBC URL directly:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopmate_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
SHOW_SQL=true

# NVIDIA NIM / OpenAI-Compatible API Configuration
# Get your NVIDIA API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

