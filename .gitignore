# ==============================================================================
# ShopMate Root .gitignore
# ==============================================================================

# Environment files & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# Backup archives & large binaries
*.zip
*.tar.gz
*.tgz
*.rar

# Node / Frontend build outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Java / Maven build outputs
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.apt_generated/

# OS generated files
.DS_Store
Thumbs.db
